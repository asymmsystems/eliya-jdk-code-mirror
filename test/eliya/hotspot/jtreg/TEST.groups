# Eliya JTREG test groups - see ADR-00011 sec.5.2.
# Fast-feedback subset bundled into upstream tier1 via platform repo's
# Makefile (`make test-tier1` at platform level forwards both).
#
# Group names use '_' not '-': jtreg rejects hyphens in group names
# ("invalid name for group"). Allowed charset is [A-Za-z0-9_].

eliya_tier1 = \
  runtime/Eliya/

# Full Eliya suite (currently identical to tier1; placeholder for future
# Phase 1.5 / Phase 4 expansion).
eliya_all = \
  runtime/Eliya/
